{
  "name": "FactChecker Extension",
  "description": "A Grammarly-style extension that factcheckes the articles you read on the web",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_icon": "images/hello_extensions.png"
  },
  "content_scripts": [
    {
      "js": ["scripts/Readability.js", "scripts/diff_match_patch.js", "scripts/highlight.js", "scripts/read_content.js"],
      "matches": [
        "https://www.naturalnews.com/2026-06-23-herbal-teas-natures-secret-health-pharma-suppression.html"
      ]
    }
  ]
}

